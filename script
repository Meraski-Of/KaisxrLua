    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then 
            table.insert(plist, p.DisplayName .. " (@" .. p.Name .. ")") 
        end
    end
    if #plist == 0 then table.insert(plist, "No Players Found") end
    return plist
end

