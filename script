-- UTILITIES & ACCURATE TELEPORT LOGIC
---------------------------------------------------------

local function GetHRP()
    local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    return char and (char:FindFirstChild("HumanoidRootPart") or char:WaitForChild("HumanoidRootPart", 2))
end

local function GetRole(player)
    if not player or not player.Character then return "Innocent" end
    local char = player.Character
    if char:FindFirstChild("Knife") or char:FindFirstChild("Revolver") then return "Murderer" end
    if char:FindFirstChild("Gun") then return "Sheriff" end
    
    local bp = player:FindFirstChild("Backpack")
    if bp then
        if bp:FindFirstChild("Knife") then return "Murderer" end
        if bp:FindFirstChild("Gun") then return "Sheriff" end
    end
    return "Innocent"
end

local function GetLocalRole()
    return GetRole(LocalPlayer)
end

-- Lobiye Işınlanma
local function TeleportToLobby()
    local hrp = GetHRP()
    if not hrp then return end

    for _, obj in ipairs(Workspace:GetChildren()) do
        if obj.Name:lower() == "lobby" or obj.Name:lower():find("lobby") then
            local spawnPart = obj:FindFirstChild("Spawns", true) or obj:FindFirstChild("Spawn", true) or obj:FindFirstChild("LobbySpawn", true)
            if spawnPart then
                local targetPart = spawnPart:IsA("BasePart") and spawnPart or spawnPart:FindFirstChildWhichIsA("BasePart", true)
                if targetPart then
                    hrp.CFrame = targetPart.CFrame + Vector3.new(0, 3.5, 0)
                    return
                end
            end
            local anyPart = obj:FindFirstChildWhichIsA("BasePart", true)
            if anyPart then
                hrp.CFrame = anyPart.CFrame + Vector3.new(0, 5, 0)
                return
            end
        end
    end
end

-- Haritaya Işınlanma
local function TeleportToMap()
    local hrp = GetHRP()
    if not hrp then return end

    for _, obj in ipairs(Workspace:GetChildren()) do
        if obj:IsA("Model") and not obj.Name:lower():find("lobby") then
            if obj:FindFirstChild("CoinContainer") or obj:FindFirstChild("Spawns") or obj:FindFirstChild("SpawnPoints") then
                local spawns = obj:FindFirstChild("Spawns") or obj:FindFirstChild("SpawnPoints") or obj:FindFirstChild("CoinContainer")
                local targetPart = spawns:FindFirstChildWhichIsA("BasePart", true)
                
                if not targetPart then
                    targetPart = obj:FindFirstChildWhichIsA("BasePart", true)
                end

                if targetPart then
                    hrp.CFrame = targetPart.CFrame + Vector3.new(0, 4, 0)
                    return
                end
            end
        end
    end
end

-- TARGET OYUNCUYU BULMA
local function FindPlayerByRawString(str)
    if type(str) == "table" then
        str = str[1] or tostring(str)
    end
    if not str or type(str) ~= "string" then return nil end
    
    local extractedUsername = str:match("%(@(.+)%)")
    
    for _, p in ipairs(Players:GetPlayers()) do
        if extractedUsername and p.Name == extractedUsername then
            return p
        elseif p.Name == str or p.DisplayName == str then
            return p
        end
    end
    return nil
end

-- TARGET OYUNCUYA IŞINLANMA
local function TeleportToSelectedTarget()
    local hrp = GetHRP()
    if not hrp then return end

    if not SelectedTargetRaw then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer then
                SelectedTargetRaw = p.DisplayName .. " (@" .. p.Name .. ")"
                break
            end
        end
    end

    local targetPlayer = FindPlayerByRawString(SelectedTargetRaw)
    if targetPlayer and targetPlayer.Character then
        local targetHRP = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
        if targetHRP then
            hrp.CFrame = targetHRP.CFrame + Vector3.new(0, 2.5, 0)
        end
    end
end

---------------------------------------------------------
-- OPTIMIZED ESP LOGIC
---------------------------------------------------------

local function ClearVisuals()
    for _, h in pairs(ESPHighlights) do if h then h:Destroy() end end
    for _, tag in pairs(NameESPObjects) do if tag then tag:Destroy() end end
    if GunESPObject then GunESPObject:Destroy() GunESPObject = nil end
    ESPHighlights = {}
    NameESPObjects = {}
end

local function UpdateVisuals()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("Head") and p.Character:FindFirstChild("HumanoidRootPart") then
            local char = p.Character
            local head = char.Head
            local role = GetRole(p)
            
            local color = Color3.fromRGB(50, 205, 50)
            if role == "Murderer" then color = Color3.fromRGB(255, 30, 30)
            elseif role == "Sheriff" then color = Color3.fromRGB(30, 144, 255) end

            if ToggleStates.ESP then
                local highlight = ESPHighlights[p]
                if not highlight or highlight.Parent ~= char then
                    if highlight then highlight:Destroy() end
                    highlight = Instance.new("Highlight")
                    highlight.Name = "Kaisxr_Highlight"
                    highlight.FillTransparency = 0.4
                    highlight.OutlineTransparency = 0
                    highlight.Parent = char
                    ESPHighlights[p] = highlight
                end
                highlight.FillColor = color
            else
                if ESPHighlights[p] then
                    ESPHighlights[p]:Destroy()
                    ESPHighlights[p] = nil
                end
            end

            if ToggleStates.NameESP then
                local bGui = NameESPObjects[p]
                if not bGui or bGui.Parent ~= head then
                    if bGui then bGui:Destroy() end
                    bGui = Instance.new("BillboardGui")
                    bGui.Name = "Kaisxr_NameESP"
                    bGui.Adornee = head
                    bGui.Size = UDim2.new(0, 150, 0, 30)
                    bGui.StudsOffset = Vector3.new(0, 2.5, 0)
                    bGui.AlwaysOnTop = true
                    bGui.Parent = head

                    local txtLabel = Instance.new("TextLabel")
                    txtLabel.Name = "Tag"
                    txtLabel.Size = UDim2.new(1, 0, 1, 0)
                    txtLabel.BackgroundTransparency = 1
                    txtLabel.Font = Enum.Font.SourceSansBold
                    txtLabel.TextSize = 15
                    txtLabel.TextStrokeTransparency = 0
                    txtLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
                    txtLabel.Parent = bGui
                    NameESPObjects[p] = bGui
                end

                local label = bGui:FindFirstChild("Tag")
                if label then
                    label.Text = string.format("[%s]\n%s", role:upper(), p.DisplayName)
                    label.TextColor3 = color
                end
            else
                if NameESPObjects[p] then
                    NameESPObjects[p]:Destroy()
                    NameESPObjects[p] = nil
                end
            end
        else
            if ESPHighlights[p] then ESPHighlights[p]:Destroy() ESPHighlights[p] = nil end
            if NameESPObjects[p] then NameESPObjects[p]:Destroy() NameESPObjects[p] = nil end
        end
    end

    if ToggleStates.GunESP then
        local gunDrop = Workspace:FindFirstChild("GunDrop", true)
        if gunDrop and gunDrop:IsA("BasePart") then
            if not GunESPObject or GunESPObject.Parent ~= gunDrop then
                if GunESPObject then GunESPObject:Destroy() end
                GunESPObject = Instance.new("BillboardGui")
                GunESPObject.Name = "Kaisxr_GunESP"
                GunESPObject.Adornee = gunDrop
                GunESPObject.Size = UDim2.new(0, 150, 0, 30)
                GunESPObject.StudsOffset = Vector3.new(0, 2, 0)
                GunESPObject.AlwaysOnTop = true
                GunESPObject.Parent = gunDrop

                local txtLabel = Instance.new("TextLabel")
                txtLabel.Name = "Tag"
                txtLabel.Size = UDim2.new(1, 0, 1, 0)
                txtLabel.BackgroundTransparency = 1
                txtLabel.Font = Enum.Font.SourceSansBold
                txtLabel.TextSize = 16
                txtLabel.TextColor3 = Color3.fromRGB(255, 215, 0)
                txtLabel.TextStrokeTransparency = 0
                txtLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
                txtLabel.Text = "[DROPPED GUN]"
                txtLabel.Parent = GunESPObject
            end
        else
            if GunESPObject then GunESPObject:Destroy() GunESPObject = nil end
        end
    else
        if GunESPObject then GunESPObject:Destroy() GunESPObject = nil end
    end
end

