-- NOCLIP LOOP
RunService.Stepped:Connect(function()
    if ToggleStates.AntiFling then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                for _, part in ipairs(p.Character:GetChildren()) do
                    if part:IsA("BasePart") then part.CanCollide = false end
                end
            end
        end
    end

    if ToggleStates.AutoFarm then
        local char = LocalPlayer.Character
        if char then
            for _, part in ipairs(char:GetChildren()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                end
            end
        end
    end
end)

RunService.Heartbeat:Connect(function()
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("Humanoid") then
        local hum = char.Humanoid
        if ToggleStates.WalkSpeed then hum.WalkSpeed = ToggleStates.WalkSpeedVal end
        if ToggleStates.JumpPower then
            hum.UseJumpPower = true
            hum.JumpPower = ToggleStates.JumpPowerVal
        end
    end

    if ToggleStates.ESP or ToggleStates.NameESP or ToggleStates.GunESP then
        UpdateVisuals()
    end
end)

-- NOCLIP SMOOTH COIN FARM LOOP (Hız: 20 - Doğal Oyuncu Hızı)
task.spawn(function()
    local farmSpeed = 20

    while true do
        task.wait(0.1)
        if ToggleStates.AutoFarm then
            local hrp = GetHRP()
            if hrp then
                local coinContainer = nil
                for _, obj in ipairs(Workspace:GetChildren()) do
                    if obj:IsA("Model") and not obj.Name:lower():find("lobby") then
                        coinContainer = obj:FindFirstChild("CoinContainer") or obj:FindFirstChild("Normal")
                        if coinContainer then break end
                    end
                end
                
                if not coinContainer then
                    coinContainer = Workspace:FindFirstChild("CoinContainer") or Workspace:FindFirstChild("Normal")
                end

                if coinContainer then
                    for _, v in ipairs(coinContainer:GetChildren()) do
                        if not ToggleStates.AutoFarm then break end
                        if v.Name == "Coin" or v.Name == "CoinVisual" or v.Name:lower():find("coin") then
                            local targetPart = v:IsA("BasePart") and v or v:FindFirstChildWhichIsA("BasePart", true)
                            if targetPart and targetPart.Parent then
                                local distance = (hrp.Position - targetPart.Position).Magnitude
                                local travelTime = distance / farmSpeed
                                
                                local tweenInfo = TweenInfo.new(travelTime, Enum.EasingStyle.Linear)
                                local tween = TweenService:Create(hrp, tweenInfo, {CFrame = targetPart.CFrame})
                                tween:Play()
                                
                                local timeSpent = 0
                                while timeSpent < travelTime and ToggleStates.AutoFarm do
                                    task.wait(0.05)
                                    timeSpent = timeSpent + 0.05
                                end
                                
                                if not ToggleStates.AutoFarm then
                                    tween:Cancel()
                                    break
                                end
                            end
                        end
                    end
                end
            end
        end
    end
end)

-- Auto Grab Gun Loop
task.spawn(function()
    while true do
        task.wait(0.5)
        if ToggleStates.AutoGrabGun and GetLocalRole() ~= "Murderer" then
            local hrp = GetHRP()
            if hrp then
                local gunDrop = Workspace:FindFirstChild("GunDrop", true)
                if gunDrop and gunDrop:IsA("BasePart") then
                    local originalCFrame = hrp.CFrame
                    hrp.CFrame = gunDrop.CFrame + Vector3.new(0, 1, 0)
                    task.wait(0.2)
                    hrp.CFrame = originalCFrame
                end
            end
        end
    end
end)

